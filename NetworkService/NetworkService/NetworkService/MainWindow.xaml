<Window 
    x:Class="NetworkService.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:NetworkService"
    xmlns:viewModel="clr-namespace:NetworkService.ViewModel"
    xmlns:views="clr-namespace:NetworkService.Views"
    Name="MainWindowRef"
    Title="MainWindow" 
    Height="800" 
    Width="360"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    mc:Ignorable="d">
    <Window.DataContext>
        <viewModel:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModel:NetworkEntitiesViewModel}">
            <views:NetworkEntitiesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:NetworkDisplayViewModel}">
            <views:NetworkDisplayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModel:MeasurementGraphViewModel}">
            <views:MeasurementGraphView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border Background="Gray" CornerRadius="25"/>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ContentControl
                Grid.Row="1"
                Grid.Column="0"
                Grid.RowSpan="1"
                Content="{Binding CurrentViewModel}" />
            
            <Border Background="#333333" CornerRadius="25, 25, 0, 0" Grid.Row="0" Grid.Column="0"/>
            <Border Background="#333333" CornerRadius="0, 0, 25, 25" Grid.Row="2" Grid.Column="0"/>
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>


                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Command="{Binding NavCommand}"
                    CommandParameter="NetworkEntities"
                    Style="{StaticResource MenuButtonStyle}">
                    <Image 
                        Source="/Assets/Icons/home_icon.png" 
                        Stretch="Uniform"
                        Margin="10,10"/>
                </Button>

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Command="{Binding NavCommand}"
                    CommandParameter="NetworkDisplay"
                    Style="{StaticResource MenuButtonStyle}">
                    <Image 
                        Source="/Assets/Icons/display_icon.png" 
                        Stretch="Uniform"
                        Margin="10,10"/>
                </Button>

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Command="{Binding NavCommand}"
                    CommandParameter="MeasurementGraph"
                    Style="{StaticResource MenuButtonStyle}">
                    <Image 
                    Source="/Assets/Icons/graph_icon.png" 
                    Stretch="Uniform"
                    Margin="10,10"/>
                </Button>

                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    Command="{Binding NavCommand}"
                    CommandParameter="Undo"
                    Style="{StaticResource MenuButtonStyle}">
                    <Image 
                    Source="/Assets/Icons/undo_icon.png" 
                    Stretch="Uniform"
                    Margin="10,10"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
