<UserControl 
    x:Class="NetworkService.Views.NetworkEntitiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:local="clr-namespace:NetworkService.Views"
    xmlns:viewModel="clr-namespace:NetworkService.ViewModel"
    d:DesignHeight="640"
    d:DesignWidth="360"
    Background="Transparent"
    mc:Ignorable="d">
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border Background="#A4A4A4" CornerRadius="15" Grid.Row="1" Grid.Column="0" Margin="5"/>
        
        <TextBlock
            Style="{StaticResource DefaultTextBlockStyle}"
            Grid.Row="0"
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="NETWORK ENTITIES"
            FontWeight="Bold"
            FontSize="30"
            Foreground="Black"/>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Grid.Row="1"
            Grid.Column="0"
            Margin="0">
            <StackPanel
                Orientation="Vertical"
                Margin="0,5">
                <RadioButton
                    HorizontalAlignment="Center"
                    GroupName="IDOperators"
                    IsChecked="{Binding LessThanRadioButton, Mode=TwoWay}">
                </RadioButton>
                <Label
                    Style="{StaticResource DefaultLabelStyle}"
                    HorizontalAlignment="Center"
                    Content="&lt;"
                    FontWeight="Bold"
                    Foreground="Black"/>
            </StackPanel>

            <StackPanel
                Orientation="Vertical"
                Margin="0,5">
                <RadioButton
                    HorizontalAlignment="Center"
                    IsChecked="{Binding EqualToRadioButton, Mode=TwoWay}"
                    GroupName="IDOperators">
                </RadioButton>
                <Label
                    Style="{StaticResource DefaultLabelStyle}"
                    HorizontalAlignment="Center"
                    Content="="
                    FontWeight="Bold"
                    Foreground="Black"/>
            </StackPanel>

            <StackPanel
                Orientation="Vertical"
                Margin="0,5">
                <RadioButton
                    HorizontalAlignment="Center"
                    IsChecked="{Binding GreaterThanRadioButton, Mode=TwoWay}"
                    GroupName="IDOperators">
                </RadioButton>
                <Label
                    Style="{StaticResource DefaultLabelStyle}"
                    HorizontalAlignment="Center"
                    Content=">"
                    FontWeight="Bold"
                    Foreground="Black"/>
            </StackPanel>

            <TextBox
                Style="{StaticResource DefaultTextBoxStyle}"
                Text="{Binding FilterIDTextBox, Mode=TwoWay}"
                Width="50"
                Background="#D9D9D9"
                Foreground="Black"
                Margin="0,5"
                VerticalContentAlignment="Center"
                FontSize="12"
                FontWeight="Bold"/>

            <ComboBox
                Width="120"
                Margin="5"
                ItemsSource="{Binding FilterTypes}"
                SelectedItem="{Binding FilterTypeComboBox, Mode=TwoWay}"
                FontSize="12"
                FontFamily="Century Gothic"
                FontWeight="Bold"
                VerticalContentAlignment="Center"/>

            <Button
            Grid.Row="0"
            Grid.Column="3"
            Command="{Binding FilterCommand}"
            CommandParameter="SearchFilter"
            Style="{StaticResource FilterButtonStyle}"
            Background="#D9D9D9">
                <Image 
                Source="/Assets/Icons/search_icon.png" 
                Stretch="Uniform"
                Margin="10,10"/>
            </Button>

            <Button
            Grid.Row="0"
            Grid.Column="3"
            Command="{Binding FilterCommand}"
            CommandParameter="ResetFilter"
            Style="{StaticResource FilterButtonStyle}"
            Background="#D9D9D9"
            Margin="5">
                <Image 
                Source="/Assets/Icons/x_icon.png" 
                Stretch="Uniform"
                Margin="10,10"/>
            </Button>
        </StackPanel>

        <DataGrid
        x:Name="EntityDataGrid"
        Grid.Row="2"
        Grid.Column="0"
        Margin="0"
        IsReadOnly="True" 
        AutoGenerateColumns="False"
        ScrollViewer.CanContentScroll="True" 
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        Background="#1A1A1A"
        CanUserReorderColumns="False"
        CanUserResizeColumns="False"
        CanUserResizeRows="False"
        CanUserSortColumns="False"
        BorderBrush="White"
        BorderThickness="0"
        ItemsSource="{Binding DERs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        RowStyle="{StaticResource DefaultDataGridRowStyle}">
            <DataGrid.Columns>

                <DataGridTemplateColumn 
                Width="0.5*" 
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                Header="ID"
                Binding="{Binding Id}"
                Width="0.5*"
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}"/>

                <DataGridTextColumn
                Header="Name"
                Binding="{Binding Name}"
                Width="*"
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}"/>

                <DataGridTextColumn
                Header="Type"
                Binding="{Binding Type.Name}"
                Width="2*"
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}"/>

                <DataGridTextColumn
                Header="Value"
                Binding="{Binding Power}"
                Width="*"
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel
            Grid.Row="3"
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">

            <Button
            Grid.Row="0"
            Grid.Column="3"
            Command="{Binding EntityCommand}"
            CommandParameter="AddEntity"
            Style="{StaticResource EntityButtonStyle}"
            Background="#D9D9D9"
            Margin="15">
                <Image 
                Source="/Assets/Icons/add_icon.png" 
                Stretch="Uniform"
                Margin="10,10"/>
            </Button>

            <Button
            Grid.Row="0"
            Grid.Column="3"
            Command="{Binding EntityCommand}"
            CommandParameter="DeleteEntity"
            Style="{StaticResource EntityButtonStyle}"
            Background="#D9D9D9"
            Margin="15">
                <Image 
                Source="/Assets/Icons/delete_icon.png" 
                Stretch="Uniform"
                Margin="10,10"/>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
