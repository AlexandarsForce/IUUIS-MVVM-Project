<UserControl 
    x:Class="NetworkService.Views.NetworkEntitiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
    xmlns:local="clr-namespace:NetworkService.Views"
    xmlns:viewModel="clr-namespace:NetworkService.ViewModel"
    d:DesignHeight="640"
    d:DesignWidth="360"
    Background="Transparent"
    mc:Ignorable="d">
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <DataGrid
        x:Name="SongsDataGrid"
        Grid.Row="1"
        Grid.Column="0"
        Margin="0"
        IsReadOnly="True" 
        AutoGenerateColumns="False"
        ScrollViewer.CanContentScroll="True" 
        ScrollViewer.VerticalScrollBarVisibility="Auto"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        Background="#1A1A1A"
        CanUserReorderColumns="False"
        CanUserResizeColumns="False"
        CanUserResizeRows="False"
        CanUserSortColumns="False"
        BorderBrush="White"
        BorderThickness="0"
        ItemsSource="{Binding Path=DERs}"
        RowStyle="{StaticResource DefaultDataGridRowStyle}">
            <DataGrid.Columns>

                <DataGridTemplateColumn 
                Width="0.5*" 
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                Header="ID"
                Binding="{Binding Id}"
                Width="0.5*"
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}"/>

                <DataGridTextColumn
                Header="Name"
                Binding="{Binding Name}"
                Width="*"
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}"/>

                <DataGridTextColumn
                Header="Type"
                Binding="{Binding Type.Name}"
                Width="2*"
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}"/>

                <DataGridTextColumn
                Header="Value"
                Binding="{Binding Power}"
                Width="*"
                HeaderStyle="{StaticResource DefaultDataGridStyle}"
                CellStyle="{StaticResource DefaultDataGridCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
