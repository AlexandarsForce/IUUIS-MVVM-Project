                Width="90"
                Height="20"
                FontSize="15"
                FontWeight="Bold"
                Background="#D9D9D9"
                Foreground="Black">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}  ID: {0} : {1}">
                            <Binding Path="DERInfo[0].Id"/>
                            <Binding Path="DERInfo[0].Power"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Button
                Style="{StaticResource DisplayButtonStyle}"
                Cursor="Hand"
                ToolTip="Remove Item From Grid"
                Command="{Binding ClearCanvasCommand}"
                CommandParameter="0"
                Width="20"
                Height="20"
                VerticalAlignment="Top">
                    <Image 
                    Source="/Assets/Icons/x_icon.png" 
                    Stretch="Uniform"
                    Margin="5"/>
                </Button>
            </DockPanel>
            <Border
            Grid.Row="0" Grid.Column="0"
            BorderBrush="{Binding BorderBrushCollection[0]}"
            BorderThickness="3">
            </Border>

