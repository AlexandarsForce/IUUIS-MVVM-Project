            Grid.Row="3" Grid.Column="2">
                <ContentControl 
                DockPanel.Dock="Top"
                Width="90"
                Height="60"
                Margin="10,0"
                Content="{Binding Path=CanvasCollection[11]}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Drop">
                            <i:InvokeCommandAction Command="{Binding DropDEROnCanvasCommand}" CommandParameter="11"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding MouseLeftButtonDownCommand}" CommandParameter="11"/>
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeftButtonUp">
                            <i:InvokeCommandAction Command="{Binding MouseLeftButtonUpCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ContentControl>
                <TextBlock
                VerticalAlignment="Top"
                Width="90"
                Height="20"
                FontSize="15"
                FontWeight="Bold"
                Background="#D9D9D9"
                Foreground="Black">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{} ID: {0} : {1}">
                            <Binding Path="DERInfo[11].Id"/>
                            <Binding Path="DERInfo[11].Power"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Button
                Style="{StaticResource DisplayButtonStyle}"
                Cursor="Hand"
                ToolTip="Remove Item From Grid"
                Command="{Binding ClearCanvasCommand}"
                CommandParameter="11"
                Width="20"
                Height="20"
                VerticalAlignment="Top">
                    <Image 
                    Source="/Assets/Icons/x_icon.png" 
                    Stretch="Uniform"
                    Margin="5"/>
                </Button>
            </DockPanel>
            <Border
            Grid.Row="3" Grid.Column="2"
            BorderBrush="{Binding BorderBrushCollection[11]}"
            BorderThickness="3">
            </Border>

        </Grid>

    </Grid>
</UserControl>
